# Copy to .env and fill in local values. Do not commit .env.
# Connection-string passwords should avoid delimiters such as semicolons and commas.
POSTGRES_DB=jobfree
POSTGRES_USER=jobfree
POSTGRES_PASSWORD=change_me_postgres_password
REDIS_PASSWORD=change_me_redis_password
RABBITMQ_USER=jobfree
RABBITMQ_PASSWORD=change_me_rabbitmq_password
MINIO_ROOT_USER=jobfree
MINIO_ROOT_PASSWORD=change_me_minio_password
S3_REGION=us-east-1
# Optional existing bucket; when empty, storage readiness checks ListBuckets permission.
S3_HEALTH_CHECK_BUCKET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
PGADMIN_DEFAULT_EMAIL=admin@jobfree.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# Optional host port overrides; all ports bind to 127.0.0.1.
API_PORT=8080
POSTGRES_PORT=15432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PGADMIN_PORT=5050
